            <column caption='Risk Level' datatype='string' name='[Calculation_0542356175077376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pct_change] &lt; 15 AND [pct_change (county_wage_change_since_2020.csv)] &gt;= 20 THEN &quot;Break Even&quot;&#13;&#10;ELSEIF [pct_change] &lt; 30 AND [pct_change (county_wage_change_since_2020.csv)] &gt; 15 THEN &quot;High Risk&quot;&#13;&#10;ELSEIF [pct_change] &gt; 25 AND [pct_change (county_wage_change_since_2020.csv)] &lt; 20 THEN &quot;Low Risk&quot;&#13;&#10;ELSE &quot;Medium Risk&quot;&#13;&#10;END' />
            </column>
